# ==============================================================================
# CryptSentinel / AICS Production & Development Environment Configuration
# ==============================================================================

# Server Environment Mode ('production' | 'development')
NODE_ENV=production

# Backend HTTP & WebSocket Port (Default: 8000)
PORT=8000

# Backend Host Binding (Default: 0.0.0.0 for containers, 127.0.0.1 for local)
HOST=0.0.0.0

# Python ML Microservice URL (Default: http://127.0.0.1:5001)
ML_SERVICE_URL=http://127.0.0.1:5001

# Sandbox Directory for Monitored File System Operations
SANDBOX_DIR=./monitored_sandbox

# Quarantine Vault Directory for Isolated Threat Storage
QUARANTINE_DIR=./quarantine

# SQLite Database File Path (Default: ./cryptsentinel.db)
DB_PATH=./cryptsentinel.db

# Frontend Build Variables (Optional overrides)
# VITE_API_BASE_URL=/api
# VITE_WS_URL=ws://localhost:8000/ws/telemetry
# VITE_ENABLE_SIMULATION=false
